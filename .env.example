# Phishing Email Scanner Configuration
# Copy this file to .env and fill in values

# Gemini API Key (required only for LLM escalation)
GEMINI_API_KEY=...

# Scanner Thresholds
SCANNER_SAFE_THRESHOLD=45
SCANNER_PHISHING_THRESHOLD=70

# Model Configuration
SCANNER_MODEL_PATH=data/model/classifier.joblib

# LLM Configuration
SCANNER_LLM_ENABLED=true
SCANNER_LLM_MODEL=gemini-2.5-flash

# Reproducibility
SCANNER_RANDOM_SEED=42
